  "claims": [
    {
      "text": "When OpenCode is connected to OpenDesign through MCP, your coding agent no longer generates code from vague descriptions",
      "confidence": null,
      "evidence_refs": []
    },
    {
      "text": "The result is something much more interesting than another AI coding assistant",
