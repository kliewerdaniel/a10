# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated full-text RSS feed (built by `npm run prebuild` -> scripts/generate-feed.mjs)
/public/feed.xml
/public/rss.xml
# generated per-post plain-text mirrors (public/blog-txt/*.txt)
/public/blog-txt/*.txt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tie output
/tie/data/
/tie/*.egg-info/
__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts
